# Copy this file to .env (use `cp`, not `mv` — keep this template around)
# and fill in real values. Never commit .env.

# --- General ---
APP_NAME="AI Work Journal"
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Telegram ---
# Create a bot via @BotFather to get TELEGRAM_TOKEN.
TELEGRAM_TOKEN=
# Your own numeric Telegram user ID (e.g. from @userinfobot). Restricts the
# bot to only respond to you — required for single-user MVP security.
TELEGRAM_ALLOWED_USER_ID=
# A random string you choose; Telegram echoes it back on every webhook call
# so you can verify requests actually came from Telegram.
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS URL Telegram should POST updates to, e.g.
# https://your-app.up.railway.app/webhook/telegram (or an ngrok URL locally).
TELEGRAM_WEBHOOK_URL=

# --- LLM providers ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Used only for embeddings (semantic task matching) — Anthropic has no
# embeddings API, so OpenAI is used for this one piece even though Claude
# is the main reasoning provider.
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large

# --- Google Sheets ---
# Paste the full service account JSON as one line, OR set
# GOOGLE_SERVICE_ACCOUNT_FILE to a path instead. Only one is needed.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
# IMPORTANT for personal (non-Workspace) Google accounts: service accounts
# have zero Drive storage quota of their own, so they CANNOT create a new
# spreadsheet (Google returns a 403 "storage quota exceeded" error) — they
# can only edit spreadsheets shared with them. So:
#   1. Create a blank sheet yourself at https://sheets.new
#   2. Share it with your service account's client_email (from the JSON
#      key) with Editor access
#   3. Paste the spreadsheet ID (from its URL) below
# Only leave this blank if your service account has real Drive quota
# (Workspace domain-wide delegation / a Shared Drive) — rare for personal use.
GOOGLE_SHEET_ID=
# Your personal Google account email. If GOOGLE_SHEET_ID is blank and the
# app does auto-create a spreadsheet, it shares it with this address so you
# can see it in your own Drive.
GOOGLE_ACCOUNT_EMAIL=
GOOGLE_SHEET_NAME="AI Work Journal"

# --- Storage ---
DATABASE_PATH=data/ai_work_journal.db

# --- Decision Engine thresholds ---
CONFIDENCE_AUTO_APPLY=0.95
CONFIDENCE_CONFIRM_LOWER_BOUND=0.80

# --- Reminders / reports ---
REMINDERS_ENABLED=true
REMINDER_HOUR_LOCAL=18
REMINDER_MINUTE_LOCAL=0
TIMEZONE=Asia/Singapore
WEEKLY_SUMMARY_ENABLED=true
WEEKLY_SUMMARY_WEEKDAY=4
WEEKLY_SUMMARY_HOUR_LOCAL=17
